# Supabase Configuration
# Replace with your project credentials from Supabase Dashboard (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Server-side service role key for keep-alive cron and administrative tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Authorization Bearer secret for Vercel Cron keep-alive endpoint (/api/cron/keep-alive)
CRON_SECRET=your-cron-secret-token
